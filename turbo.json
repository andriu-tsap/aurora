{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "out/**",
        ".next/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {},
    "@aurora/admin#build": {
      "dependsOn": [
        "@aurora/web#build"
      ],
      "cache": false
    }
  },
  "globalEnv": [
    "NEXT_PUBLIC_BASE_PATH"
  ]
}
